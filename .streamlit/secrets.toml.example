# Pune Transit Complaint Analyzer - Secrets Configuration Example
#
# Note: This application runs completely locally with bundled scikit-learn models
# and does not require external API keys, database credentials, or paid cloud services.
#
# If you integrate third-party APIs (e.g., Slack alerts, external storage) in the future,
# define them here and mirror them in Streamlit Community Cloud Settings > Secrets.
#
# EXAMPLE:
# [api_keys]
# notification_webhook = "https://example.com/webhook"
